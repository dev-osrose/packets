<packet ePacketType = "PAKCS_CRAFT_ENHANCE_REQ">
	<documentation>Gems, disassembly and refining (the client's
		cli_CRAFT_*_REQ): what follows the type depends on it.</documentation>
	<element name = "enhancement" type = "CraftEnhancementType" />
	<choice selector = "enhancement">
		<!-- The worn piece's slot, then the gem's. -->
		<sequence case = "GEM">
			<element name = "gem_target" type = "uint8_t" />
			<element name = "gem_source" type = "uint8_t" />
		</sequence>
		<!-- The skill slot or the NPC, then the item's slot. -->
		<sequence case = "DISASSEMBLE_SKILL">
			<element name = "by" type = "int16_t" />
			<element name = "target" type = "uint8_t" />
		</sequence>
		<sequence case = "DISASSEMBLE_NPC">
			<element name = "by" type = "int16_t" />
			<element name = "target" type = "uint8_t" />
		</sequence>
		<!-- The same, then the three materials' slots. -->
		<sequence case = "UPGRADE_SKILL">
			<element name = "by" type = "int16_t" />
			<element name = "target" type = "uint8_t" />
			<element name = "materials" type = "uint8_t" occurs = "3" />
		</sequence>
		<sequence case = "UPGRADE_NPC">
			<element name = "by" type = "int16_t" />
			<element name = "target" type = "uint8_t" />
			<element name = "materials" type = "uint8_t" occurs = "3" />
		</sequence>
	</choice>

	<simpleType name = "CraftEnhancementType">
		<restriction base = "uint8_t">
			<enumeration value = "GEM" id = "1" />
			<enumeration value = "DISASSEMBLE_SKILL" />
			<enumeration value = "DISASSEMBLE_NPC" />
			<enumeration value = "UPGRADE_SKILL" />
			<enumeration value = "UPGRADE_NPC" />
		</restriction>
	</simpleType>
</packet>
