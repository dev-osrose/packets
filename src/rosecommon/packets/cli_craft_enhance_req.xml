<packet ePacketType = "PAKCS_CRAFT_ENHANCE_REQ">
	<element name = "enhancement" type = "CraftEnhancementType" />
	<!-- What follows depends on the type (the client's cli_CRAFT_*_REQ):
	     GEM: the equipment's slot, the gem's slot (two uint8);
	     DISASSEMBLE_*: the skill slot or NPC (int16), the item's slot (uint8);
	     UPGRADE_*: the skill slot or NPC (int16), the item's slot (uint8),
	     then three material slots (uint8). -->
	<element name = "payload" type = "uint8_t" occurs = "unbounded" default = "{}" />

	<simpleType name = "CraftEnhancementType">
		<restriction base = "uint8_t">
			<enumeration value = "GEM" id = "1" />
			<enumeration value = "DISASSEMBLE_SKILL" />
			<enumeration value = "DISASSEMBLE_NPC" />
			<enumeration value = "UPGRADE_SKILL" />
			<enumeration value = "UPGRADE_NPC" />
		</restriction>
	</simpleType>

</packet>