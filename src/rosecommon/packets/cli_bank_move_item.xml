<packet ePacketType = "PAKCS_BANK_MOVE_ITEM">
    <includeXml path = "item.xml" />

    <element name = "mode" type = "BankMoveItemMode" />
    <element name = "index" type = "uint8_t" />
    <element name = "item" type = "Item" />
    <element name = "use_special_tab" type = "uint8_t" />

    <!-- MOVE_ITEM_TYPE_*; money moves are MOVE_ZULY_TYPE_* (0x10, 0x11). -->
    <simpleType name = "BankMoveItemMode">
        <restriction base = "uint8_t">
            <enumeration value = "INVENTORY_TO_BANK" id = "0" />
            <enumeration value = "BANK_TO_INVENTORY" id = "1" />
        </restriction>
    </simpleType>
</packet>