<definitions name = "packet_type">
    <documentation>
        The type id of every packet: the second 16-bit word of each packet.
        CS: client to server, SC: server to client, SS: server to server,
        LC: login server to client, CC: character server to client,
        WC: world (zone) server to client.
    </documentation>
    <simpleType name = "ePacketType" scoped = "true">
        <restriction base = "uint16_t">
            <enumeration value = "ISCSTART" id = "0x300" />
            <enumeration value = "ISC_ALIVE" />
            <enumeration value = "ISC_SERVER_REGISTER" />
            <enumeration value = "ISC_TRANSFER">
                <documentation>transfer to specific map(s)</documentation>
            </enumeration>
            <enumeration value = "ISC_TRANSFER_CHAR">
                <documentation>transfer to specific character(s) (map(s) is/are determined automatically for you)</documentation>
            </enumeration>
            <enumeration value = "ISC_CLIENT_STATUS">
                <documentation>maps send this packet to the char server every time the status of a client changes</documentation>
            </enumeration>
            <enumeration value = "ISC_SHUTDOWN" />
            <enumeration value = "ISCEND" />

            <!-- CLIENT PACKETS START HERE!!! -->
