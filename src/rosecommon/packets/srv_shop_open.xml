<packet ePacketType = "PAKWC_SHOP_OPEN">
    <include path = "string" system = "true" />
    <element name = "id" type = "uint16_t" />
    <!-- The shop's look (the platinum store skin); the client reads it
         before the title. -->
    <element name = "skin" type = "int16_t" default = "0" />
    <element name = "name" type = "std::string" ref = "true" />
</packet>
