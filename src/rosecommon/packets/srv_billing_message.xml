<packet ePacketType = "PAKWC_BILLING_MESSAGE">
    <!-- As the client reads it (gsv_BILLING_MESSAGE2): the message type
         (BILLING_MSG_*) always, the other two only for
         BILLING_MSG_JPN_NEED_CHARGE. Type 1 is BILLING_MSG_PAY_FU. -->
    <element name = "messageType" type = "uint8_t" default = "1" />
    <element name = "functionType" type = "int8_t" default = "0" />
    <element name = "payFlag" type = "uint32_t" default = "0" />
</packet>
