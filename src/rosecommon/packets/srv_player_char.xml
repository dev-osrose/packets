<packet ePacketType = "PAKWC_PLAYER_CHAR">
    <includeXml path = "clan.xml" />
    <element name = "id" type = "uint16_t" />
    <element name = "x" type = "float" default = "0" />
    <element name = "y" type = "float" default = "0" />
    <element name = "destX" type = "float" default = "0" />
    <element name = "destY" type = "float" default = "0" />
    <element name = "command" type = "uint16_t" default = "0" />
    <element name = "targetId" type = "uint16_t" default = "0" />
    <element name = "moveMode" type = "uint8_t" default = "0" />
    <element name = "hp" type = "int32_t" default = "0" />
    <element name = "teamId" type = "int32_t" default = "0" />
    <element name = "statusFlag" type = "uint32_t" default = "0" />
    <element name = "race" type = "uint8_t" default = "0" />
    <element name = "runSpeed" type = "int16_t" default = "0" />
    <element name = "atkSpeed" type = "int16_t" default = "0" />
    <element name = "weightRate" type = "uint8_t" default = "0" />
    <element name = "face" type = "uint32_t" default = "0" />
    <element name = "hair" type = "uint32_t" default = "0" />

    <includeXml path = "equipped_item.xml" />
    <includeXml path = "item.xml" />
    <includeXml path = "bullet_type.xml" />
    <includeXml path = "riding_item.xml" />
    <include path = "dataconsts.h" />
    <include path = "string" system = "true" />

    <element name = "inventory" type = "EquippedItem" occurs = "MAX_VISIBLE_ITEMS" ref = "true" default = "{}" />
    <element name = "bullets" type = "Header" occurs = "BulletType::MaxBulletTypes" ref = "true" default = "{}" />
    <element name = "job" type = "int16_t" default = "0" />
    <element name = "level" type = "uint8_t" default = "0" />
    <element name = "ridingItems" type = "EquippedItem" occurs = "RidingItem::MaxRidingItems" ref = "true" default = "{}" />
    <element name = "z" type = "int16_t" default = "0" />
    <element name = "subFlag" type = "SubFlag" default = "NONE" />
    <element name = "name" type = "std::string" ref = "true" default = "none" />
    <!-- One value for each of max HP up, move speed up and down, attack speed
         up and down (status bits 4, 6, 7, 8, 9) that is set, in that order. -->
    <element name = "statusValues" type = "int16_t" occurs = "unbounded" occursBits = "statusFlag" occursMask = "0x3D0" default = "{}" />
    <element name = "otherName" type = "std::string" ref = "true" default = "none" />
    <!-- What follows the names, by the sub flag's exact value as the client
         switches on it: STORE_MODE a personal shop's skin and title, INTRO_CHAT
         an introduction; any other, nothing. -->
    <choice selector = "subFlag">
        <sequence case = "STORE_MODE">
            <element name = "shopSkin" type = "int16_t" />
            <element name = "shopTitle" type = "std::string" />
        </sequence>
        <sequence case = "INTRO_CHAT">
            <element name = "intro" type = "std::string" />
        </sequence>
        <sequence default = "true" />
    </choice>
    <!-- The character's clan, when it is in one: at most one entry (the
         client reads it only when its 10 bytes and the name are there). -->
    <element name = "clan" type = "ClanTag" occurs = "unbounded" default = "{}" />

    <simpleType name = "SubFlag">
        <documentation>What `FLAG_SUB_*` value a player has: the client reads
            what follows the names by it (its exact value, not as bits).</documentation>
        <restriction base = "uint32_t">
            <enumeration value = "NONE" id = "0" />
            <enumeration value = "STORE_MODE" id = "2" />
            <enumeration value = "INTRO_CHAT" id = "4" />
        </restriction>
    </simpleType>
</packet>
