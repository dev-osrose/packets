<packet ePacketType = "PAKCS_CLAN_COMMAND">
    <documentation>What a client asks of its clan (`tag_CLAN_CMD`): a command,
        then what that command takes.</documentation>
    <include path = "string" system = "true" />

    <element name = "command" type = "ClanCommand" />
    <choice selector = "command">
        <sequence case = "CREATE">
            <element name = "mark_back" type = "uint16_t" />
            <element name = "mark_center" type = "uint16_t" />
            <element name = "name" type = "std::string" />
            <element name = "slogan" type = "std::string" />
        </sequence>
        <sequence case = "INFO" />
        <sequence case = "INVITE">
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "REMOVE">
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "PROMOTE">
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "DEMOTE">
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "MOTD">
            <element name = "text" type = "std::string" />
        </sequence>
        <sequence case = "QUIT" />
        <sequence case = "ROSTER" />
        <sequence case = "LEADER">
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "DISBAND" />
        <sequence case = "INVITE_REPLY_YES">
            <element name = "inviter" type = "std::string" />
        </sequence>
        <sequence case = "INVITE_REPLY_NO">
            <element name = "inviter" type = "std::string" />
        </sequence>
        <sequence case = "SLOGAN">
            <element name = "text" type = "std::string" />
        </sequence>
        <sequence case = "MEMBER_JOB_LEVEL">
            <element name = "level" type = "int16_t" />
            <element name = "job" type = "int16_t" />
        </sequence>
    </choice>

    <simpleType name = "ClanCommand">
        <restriction base = "uint8_t">
            <enumeration value = "CREATE" id = "0x00" />
            <enumeration value = "INFO" />
            <enumeration value = "INVITE" />
            <enumeration value = "REMOVE" />
            <enumeration value = "PROMOTE" />
            <enumeration value = "DEMOTE" />
            <enumeration value = "MOTD" />
            <enumeration value = "QUIT" />
            <enumeration value = "ROSTER" />
            <enumeration value = "LEADER" />
            <enumeration value = "DISBAND" />
            <enumeration value = "INVITE_REQ" />
            <enumeration value = "INVITE_REPLY_YES" />
            <enumeration value = "INVITE_REPLY_NO" />
            <enumeration value = "SLOGAN" />
            <enumeration value = "MEMBER_JOB_LEVEL" />
        </restriction>
    </simpleType>
</packet>
