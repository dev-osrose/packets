<packet ePacketType = "PAKCC_CLAN_COMMAND">
    <documentation>What a client is told of its clan (`wsv_CLAN_COMMAND` and its
        `RESULT_CLAN_*`): a result, then what that result carries, as the
        client reads it (`Recv_wsv_CLAN_COMMAND`).</documentation>
    <include path = "string" system = "true" />
    <includeXml path = "clan.xml" />

    <element name = "result" type = "ClanResult" />
    <choice selector = "result">
        <sequence case = "INVITED">
            <element name = "inviter" type = "std::string" />
        </sequence>
        <sequence case = "REFUSED">
            <element name = "refuser" type = "std::string" />
        </sequence>
        <sequence case = "CREATED">
            <element name = "clan" type = "MyClan" />
            <element name = "name" type = "std::string" />
            <element name = "slogan" type = "std::string" />
            <element name = "motd" type = "std::string" />
        </sequence>
        <sequence case = "JOINED">
            <element name = "clan" type = "MyClan" />
            <element name = "name" type = "std::string" />
            <element name = "slogan" type = "std::string" />
            <element name = "motd" type = "std::string" />
        </sequence>
        <sequence case = "DESTROYED_MSG" />
        <sequence case = "DATA">
            <element name = "clan" type = "MyClan" />
            <element name = "name" type = "std::string" />
            <element name = "slogan" type = "std::string" />
            <element name = "motd" type = "std::string" />
        </sequence>
        <sequence case = "MOTD">
            <element name = "text" type = "std::string" />
        </sequence>
        <sequence case = "SET">
            <element name = "object_id" type = "uint16_t" />
            <element name = "clan_id" type = "ClanId" />
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "SLOGAN">
            <element name = "text" type = "std::string" />
        </sequence>
        <sequence case = "CREATE_FAILED" />
        <sequence case = "DUPLICATE_NAME" />
        <sequence case = "NO_PERMISSION" />
        <sequence case = "MISSING_CONDITION" />
        <sequence case = "DESTROYED" />
        <sequence case = "DESTROY_FAILED" />
        <sequence case = "DESTROY_NO_PERMISSION" />
        <sequence case = "JOIN_MEMBER">
            <element name = "member" type = "std::string" />
            <element name = "inviter" type = "std::string" />
        </sequence>
        <sequence case = "JOIN_FAILED">
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "JOIN_NO_PERMISSION" />
        <sequence case = "JOIN_HAS_CLAN">
            <element name = "name" type = "std::string" />
        </sequence>
        <sequence case = "JOIN_FULL" />
        <sequence case = "INFO">
            <element name = "clan" type = "MyClan" />
        </sequence>
        <sequence case = "ROSTER">
            <element name = "members" type = "ClanMember" occurs = "unbounded" />
        </sequence>
        <sequence case = "MEMBER_LOGIN">
            <element name = "row" type = "ClanMember" />
        </sequence>
        <sequence case = "MEMBER_LOGOUT">
            <element name = "row" type = "ClanMember" />
        </sequence>
        <sequence case = "MEMBER_POSITION">
            <element name = "row" type = "ClanMember" />
        </sequence>
        <sequence case = "KICK">
            <element name = "member" type = "std::string" />
            <element name = "kicker" type = "std::string" />
        </sequence>
        <sequence case = "QUIT">
            <element name = "member" type = "std::string" />
        </sequence>
        <sequence case = "POSITION">
            <element name = "by" type = "std::string" />
            <element name = "rank" type = "ClanRank" />
        </sequence>
        <sequence case = "MEMBER_JOB_LEVEL">
            <element name = "level" type = "int16_t" />
            <element name = "job" type = "int16_t" />
            <element name = "name" type = "std::string" />
        </sequence>
    </choice>

    <simpleType name = "ClanResult">
        <restriction base = "uint8_t">
            <enumeration value = "INVITED" id = "0x0B" />
            <enumeration value = "REFUSED" id = "0x0D" />
            <enumeration value = "CREATED" id = "0x30" />
            <enumeration value = "JOINED" />
            <enumeration value = "DESTROYED_MSG" />
            <enumeration value = "DATA" />
            <enumeration value = "MOTD" />
            <enumeration value = "SET" />
            <enumeration value = "SLOGAN" />
            <enumeration value = "CREATE_FAILED" id = "0x41" />
            <enumeration value = "DUPLICATE_NAME" />
            <enumeration value = "NO_PERMISSION" />
            <enumeration value = "MISSING_CONDITION" />
            <enumeration value = "DESTROYED" id = "0x51" />
            <enumeration value = "DESTROY_FAILED" />
            <enumeration value = "DESTROY_NO_PERMISSION" />
            <enumeration value = "JOIN_MEMBER" id = "0x61" />
            <enumeration value = "JOIN_FAILED" />
            <enumeration value = "JOIN_NO_PERMISSION" />
            <enumeration value = "JOIN_HAS_CLAN" />
            <enumeration value = "JOIN_FULL" />
            <enumeration value = "INFO" id = "0x71" />
            <enumeration value = "ROSTER" />
            <enumeration value = "MEMBER_LOGIN" />
            <enumeration value = "MEMBER_LOGOUT" />
            <enumeration value = "MEMBER_POSITION" />
            <enumeration value = "KICK" id = "0x81" />
            <enumeration value = "QUIT" />
            <enumeration value = "POSITION" />
            <enumeration value = "MEMBER_JOB_LEVEL" />
        </restriction>
    </simpleType>

    <complexType name = "MyClan">
        <documentation>`tag_MY_CLAN`, 152 bytes.</documentation>
        <sequence>
            <element name = "id" type = "ClanId" />
            <element name = "score" type = "int32_t" />
            <element name = "rate" type = "int32_t" />
            <element name = "money" type = "int64_t" />
            <element name = "member_count" type = "int16_t" />
            <element name = "contribution" type = "int32_t" />
            <element name = "skills" type = "ClanSkill" occurs = "20" />
        </sequence>
    </complexType>

    <complexType name = "ClanSkill">
        <sequence>
            <element name = "id" type = "int16_t" />
            <element name = "expires" type = "uint32_t" />
        </sequence>
    </complexType>

    <complexType name = "ClanMember">
        <documentation>`tag_CLAN_MEMBER` and the name.</documentation>
        <sequence>
            <element name = "rank" type = "ClanRank" />
            <element name = "channel" type = "uint8_t" />
            <element name = "contribution" type = "int32_t" />
            <element name = "level" type = "int16_t" />
            <element name = "job" type = "int16_t" />
            <element name = "name" type = "std::string" />
        </sequence>
    </complexType>

</packet>
