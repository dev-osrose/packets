<packet ePacketType = "PAKCC_MEMO">
    <documentation>A memo reply (`wsv_MEMO`, `MEMO_REPLY_*`): how many memos
        are kept, some of them (a page; the client asks again while it
        expects more), or how sending one went. Each memo carries its id, for
        deleting it (`PAKCS_MEMO` DELETE).</documentation>
    <include path = "string" system = "true" />

    <element name = "type" type = "MemoReply" />
    <choice selector = "type">
        <sequence case = "RECEIVED_COUNT">
            <element name = "count" type = "int16_t" />
        </sequence>
        <sequence case = "CONTENTS">
            <element name = "memos" type = "Memo" occurs = "unbounded" />
        </sequence>
        <sequence case = "SEND_OK" />
        <sequence case = "INVALID_TARGET" />
        <sequence case = "NOT_EXIST" />
        <sequence case = "REFUSED" />
        <sequence case = "INBOX_FULL" />
        <sequence case = "INVALID_CONTENT" />
    </choice>

    <simpleType name = "MemoReply">
        <restriction base = "uint8_t">
            <enumeration value = "RECEIVED_COUNT" id = "1" />
            <enumeration value = "CONTENTS" />
            <enumeration value = "SEND_OK" />
            <enumeration value = "INVALID_TARGET" />
            <enumeration value = "NOT_EXIST" />
            <enumeration value = "REFUSED" />
            <enumeration value = "INBOX_FULL" />
            <enumeration value = "INVALID_CONTENT" />
        </restriction>
    </simpleType>

    <complexType name = "Memo">
        <sequence>
            <element name = "id" type = "uint32_t" />
            <element name = "date" type = "uint32_t" />
            <element name = "source" type = "std::string" />
            <element name = "message" type = "std::string" />
        </sequence>
    </complexType>
</packet>
