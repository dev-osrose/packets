<packet ePacketType = "PAKCS_STORE_TRADE_REQ">
    <element name = "npc_id" type = "uint16_t" />
    <!-- How many buys and sells follow. Written as the lists' lengths. -->
    <element name = "buy_count" type = "int8_t" default = "0" />
    <element name = "sell_count" type = "int8_t" default = "0" />
    <!-- The economy version the client priced with (PAKWC_GLOBAL_VARS updateTime) -->
    <element name = "economy_time" type = "uint32_t" />
    <element name = "buys" type = "BuyItem" occurs = "unbounded" occursRef = "buy_count" default = "{}" />
    <element name = "sells" type = "SellItem" occurs = "unbounded" occursRef = "sell_count" default = "{}" />

    <complexType name = "BuyItem">
        <sequence>
            <element name = "tab_id" type = "uint8_t" default = "0" />
            <element name = "col_id" type = "uint8_t" default = "0" />
            <element name = "amount" type = "uint16_t" default = "0" />
        </sequence>
    </complexType>

    <complexType name = "SellItem">
        <sequence>
            <element name = "inventory_idx" type = "uint8_t" default = "0" />
            <element name = "amount" type = "uint16_t" default = "0" />
        </sequence>
    </complexType>
</packet>
