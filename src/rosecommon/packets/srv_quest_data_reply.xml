<packet ePacketType = "PAKWC_QUEST_DATA_REPLY">
    <element name = "result" type = "QuestDataResult" />
    <element name = "slot" type = "uint8_t" />
    <element name = "id" type = "int32_t" />

    <simpleType name = "QuestDataResult">
        <restriction base = "uint8_t">
            <enumeration value = "ADD_SUCCESS" id = "1" />
            <enumeration value = "ADD_FAIL" id = "2" />
            <enumeration value = "REMOVE_SUCCESS" id = "3" />
            <enumeration value = "REMOVE_FAIL" id = "4" />
            <enumeration value = "TRIGGER_SUCCESS" id = "5" />
            <enumeration value = "TRIGGER_FAIL" id = "6" />
        </restriction>
    </simpleType>
</packet>